# 고쳐야집 환경 설정 양식
# 적용: uv run scripts/sync_env.py
# 이 파일에는 예시 값만 작성하고, 실제 비밀번호와 비밀값은 .env에서 설정합니다.
# .env는 저장소에 커밋하지 않습니다.

# =============================================================================
# 공통 설정: 로컬·운영 Compose에서 사용하는 이미지 이름
# =============================================================================
IMAGE_NAME=eagleindesert/fix-my-home-be

# =============================================================================
# 로컬 개발: scripts/build-start.sh 및 docker-compose.yaml
# =============================================================================
# 운영용 IMAGE_TAG·IMAGE_PLATFORM과 별도로 적용됩니다.
LOCAL_IMAGE_TAG=local

# 기본값은 AMD64입니다. ARM 개발 환경에서는 linux/arm64로 변경합니다.
# build-start.sh --platform 옵션으로 이번 실행의 대상 CPU를 지정할 수도 있습니다.
LOCAL_IMAGE_PLATFORM=linux/amd64

# 로컬 요청의 허용 출처입니다. Compose에 지정한 공개 포트와 일치시킵니다.
FMH_LOCAL_ORIGIN=http://localhost:8002

# =============================================================================
# 운영 배포: 루트 start.sh 및 docker-compose-deployment.yaml
# =============================================================================
IMAGE_TAG=latest
# 버전만 지정해 시작하면 기존 플랫폼을 유지합니다.
# ./start.sh <버전> --platform linux/arm64 로 명시하면 이 설정도 갱신합니다.
IMAGE_PLATFORM=linux/arm64

# 운영에서는 아래 값을 사용합니다.
# 로컬 Compose는 개발 모드·HTTP 쿠키·FMH_LOCAL_ORIGIN으로 덮어씁니다.
FMH_ENVIRONMENT=production
FMH_COOKIE_SECURE=true

# 실제 서비스의 HTTPS 주소로 변경합니다.
FMH_PUBLIC_ORIGIN=https://your-domain.example

# =============================================================================
# 데이터베이스와 세션: 로컬·운영 공통
# =============================================================================
POSTGRES_DB=fmh
POSTGRES_USER=fmh

# 실제 사용할 긴 무작위 비밀번호로 변경합니다.
POSTGRES_PASSWORD=replace_with_a_long_random_password

# 위의 DB 이름·사용자·비밀번호와 일치시킵니다. db는 Compose 서비스 이름입니다.
# 비밀번호의 특수문자는 이 URL에 넣을 때 URL 인코딩합니다.
FMH_DATABASE_URL=postgresql+psycopg2://fmh:replace_with_a_long_random_password@db:5432/fmh

# DB 비밀번호와 다른 독립적인 비밀값으로 변경합니다. 운영에서는 32자 이상입니다.
FMH_SESSION_SECRET=replace_with_an_independent_random_secret_at_least_32_chars

# =============================================================================
# 네트워크와 프록시
# =============================================================================
# 기존 Docker 네트워크와 대역이 겹치면 아래 주소 설정을 함께 변경합니다.
DOCKER_SUBNET=172.30.0.0/24
DOCKER_GATEWAY=172.30.0.1

# 호스트 Nginx는 위 게이트웨이를 통해 접근합니다. 신뢰할 프록시 IP를 지정합니다.
FMH_TRUSTED_PROXY_IPS=172.30.0.1

# =============================================================================
# 로그
# =============================================================================
# 회전한 로그 파일의 보관 개수입니다.
FMH_LOG_BACKUPS=10

# =============================================================================
# AI 기능: 선택 설정
# =============================================================================
# AI 기능을 사용할 때 API 키와 모델을 함께 입력합니다. 미사용 시 비워 둡니다.
FMH_OPENAI_API_KEY=
FMH_OPENAI_MODEL=
