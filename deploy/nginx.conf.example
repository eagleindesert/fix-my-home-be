# Install this configuration on the Ubuntu VM host. TLS is configured on the host.
# Replace server_name and certificate paths with the host's existing values.
server {
    listen 443 ssl;
    server_name your-domain.example;
    ssl_certificate /etc/letsencrypt/live/your-domain.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/your-domain.example/privkey.pem;

    client_max_body_size 51m;
    proxy_read_timeout 75s;

    # 상태 확인은 로컬 전용입니다. 접두사가 중복된 요청에도 같은 제한을 적용합니다.
    # 정규식 location에는 proxy_pass의 URI 부분을 지정하지 않습니다.
    location ~ ^/(?:fixmyhome/api/)*health(?:/|$) {
        allow 127.0.0.1;
        deny all;
        proxy_pass http://127.0.0.1:8002;
    }

    # FMH_ROOT_PATH=/fixmyhome/api로 설정합니다.
    # proxy_pass 끝의 /가 /fixmyhome/api/를 제거합니다.
    # 외부 /fixmyhome/api/docs -> 내부 /docs
    location /fixmyhome/api/ {
        proxy_pass http://127.0.0.1:8002/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
